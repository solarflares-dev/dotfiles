timestamp=2026-09-26T20:06:13.796Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"command -v convert magick ffmpeg pngtopnm 2>/dev/null; python3 - <<'EOF'\\nimport zlib, struct\\nfrom collections import Counter\\nd = open('/home/solar/.config/waybar/assets/arch.png','rb').read()\\npos = 8; idat = b''; w=h=None; bd=ct=None\\nwhile pos < len(d):\\n    ln, typ = struct.unpack('>I4s', d[pos:pos+8]); data = d[pos+8:pos+8+ln]\\n    if typ == b'IHDR': w,h,bd,ct = struct.unpack('>IIBB', data[:10])\\n    elif typ == b'IDAT': idat += data\\n    pos += 12 + ln\\nprint('IHDR', w, h, 'bitdepth', bd, 'colortype', ct)\\nraw = zlib.decompress(idat)\\nbpp = 4\\nstride = w*bpp\\nout = bytearray(); prev = bytearray(stride)\\ni = 0\\nfor y in range(h):\\n    f = raw[i]; i += 1\\n    line = bytearray(raw[i:i+stride]); i += stride\\n    for x in range(stride):\\n        a = line[x-bpp] if x >= bpp else 0\\n        b = prev[x]; c = prev[x-bpp] if x >= bpp else 0\\n        if f == 1: line[x] = (line[x]+a) & 255\\n        elif f == 2: line[x] = (line[x]+b) & 255\\n        elif f == 3: line[x] = (line[x]+(a+b)//2) & 255\\n        elif f == 4:\\n            p = a+b-c; pa,pb,pc = abs(p-a),abs(p-b),abs(p-c)\\n            pr = a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\\n            line[x] = (line[x]+pr) & 255\\n    out += line; prev = line\\ndef px(x,y):\\n    o = y*stride + x*bpp\\n    return tuple(out[o:o+4])\\nfor n,(x,y) in {'TL':(2,2),'TR':(w-3,2),'BL':(2,h-3),'BR':(w-3,h-3),'center':(w//2,h//2),'arch-body':(w//2,int(h*0.62))}.items():\\n    print(n, px(x,y))\\nc = Counter()\\nfor y in range(0,h,3):\\n    for x in range(0,w,3):\\n        p = px(x,y)\\n        if p[3] > 200: c[p[:3]] += 1\\nprint('top opaque colors:', c.most_common(4))\\n# bounding box of non-transparent\\nminx,miny,maxx,maxy = w,h,0,0\\nfor y in range(0,h,2):\\n    for x in range(0,w,2):\\n        if px(x,y)[3] > 8:\\n            minx=min(minx,x); maxx=max(maxx,x); miny=min(miny,y); maxy=max(maxy,y)\\nprint('opaque bbox', minx,miny,'->',maxx,maxy)\\nEOF\"]" cwd=/home/solar http.span=273672 role=server
timestamp=2026-09-26T20:06:24.353Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\nimport zlib, struct\\nd = open('/home/solar/.config/waybar/assets/arch.png','rb').read()\\npos=8; idat=b''\\nwhile pos < len(d):\\n    ln,typ = struct.unpack('>I4s', d[pos:pos+8]); data=d[pos+8:pos+8+ln]\\n    if typ==b'IHDR': w,h,bd,ct = struct.unpack('>IIBB', data[:10])\\n    elif typ==b'IDAT': idat += data\\n    pos += 12+ln\\nraw = zlib.decompress(idat); bpp=4; stride=w*bpp\\nout=bytearray(); prev=bytearray(stride); i=0\\nfor y in range(h):\\n    f=raw[i]; i+=1\\n    line=bytearray(raw[i:i+stride]); i+=stride\\n    for x in range(stride):\\n        a=line[x-bpp] if x>=bpp else 0\\n        b=prev[x]; c=prev[x-bpp] if x>=bpp else 0\\n        if f==1: line[x]=(line[x]+a)&255\\n        elif f==2: line[x]=(line[x]+b)&255\\n        elif f==3: line[x]=(line[x]+(a+b)//2)&255\\n        elif f==4:\\n            p=a+b-c; pa,pb,pc=abs(p-a),abs(p-b),abs(p-c)\\n            pr=a if (pa<=pb and pa<=pc) else (b if pb<=pc else c)\\n            line[x]=(line[x]+pr)&255\\n    out+=line; prev=line\\ndef A(x,y):\\n    return out[y*stride+x*bpp+3]\\nsemi = sum(1 for y in range(h) for x in range(w) if 0 < A(x,y) < 250)\\nfull = sum(1 for y in range(h) for x in range(w) if A(x,y) >= 250)\\nclear= sum(1 for y in range(h) for x in range(w) if A(x,y) == 0)\\nprint('fully opaque:', full, 'semi(0<a<250):', semi, 'transparent:', clear)\\nprint('top-center(250,15):', A(250,15), ' (250,40):', A(250,40))\\n# alpha>0 bbox\\nminx,miny,maxx,maxy=w,h,0,0\\nfor y in range(h):\\n    for x in range(w):\\n        if A(x,y)>0:\\n            minx=min(minx,x);maxx=max(maxx,x);miny=min(miny,y);maxy=max(maxy,y)\\nprint('alpha>0 bbox', minx,miny,maxx,maxy, '-> w',maxx-minx+1,'h',maxy-miny+1)\\nEOF\"]" cwd=/home/solar http.span=284229 role=server

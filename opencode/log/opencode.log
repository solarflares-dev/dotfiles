timestamp=2026-09-26T20:13:54.909Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\nimport struct\\np = \\\"/home/solar/.local/share/fonts/JetBrains-Mono-Nerd-Font-Complete.ttf\\\"\\nd = open(p,'rb').read()\\n# parse table directory\\nnum = struct.unpack('>H', d[4:6])[0]\\ntabs = {}\\nfor i in range(num):\\n    off = 12 + i*16\\n    tag = d[off:off+4].decode('latin1')\\n    o, l = struct.unpack('>II', d[off+8:off+16])\\n    tabs[tag] = (o, l)\\n\\n# Build cmap: map unicode -> has_glyph\\ndef read_cmap(o, l):\\n    n = struct.unpack('>H', d[o+2:o+4])[0]\\n    best = None\\n    for i in range(n):\\n        r = o + 4 + i*8\\n        pid, eid, sub = struct.unpack('>HHI', d[r:r+8])\\n        fmt = struct.unpack('>H', d[o+sub:o+sub+2])[0]\\n        if fmt in (4,12): best = o+sub\\n    if best is None: return set()\\n    chars = set()\\n    fmt = struct.unpack('>H', d[best:best+2])[0]\\n    if fmt == 4:\\n        segX2 = struct.unpack('>H', d[best+6:best+8])[0]\\n        seg = segX2//2\\n        endB = best+14\\n        startB = endB + segX2 + 2\\n        deltaB = startB + segX2\\n        rangeB = deltaB + segX2\\n        for i in range(seg):\\n            end = struct.unpack('>H', d[endB+i*2:endB+i*2+2])[0]\\n            start = struct.unpack('>H', d[startB+i*2:startB+i*2+2])[0]\\n            delta = struct.unpack('>h', d[deltaB+i*2:deltaB+i*2+2])[0]\\n            ro = struct.unpack('>H', d[rangeB+i*2:rangeB+i*2+2])[0]\\n            if start == 0xFFFF: continue\\n            for c in range(start, min(end, 0xFFFF)+1):\\n                if ro == 0:\\n                    g = (c + delta) & 0xFFFF\\n                else:\\n                    gi = rangeB + i*2 + ro + (c-start)*2\\n                    if gi+2 > len(d): continue\\n                    g = struct.unpack('>H', d[gi:gi+2])[0]\\n                    if g: g = (g + delta) & 0xFFFF\\n                if g: chars.add(c)\\n    return chars\\n\\nchars = read_cmap(*tabs['cmap'])\\nprint(\\\"cmap codepoints:\\\", len(chars))\\n# Nerd Font Material Design wifi icons\\ntests = {\\n  \\\"nf-md-wifi (F0E9?)\\\": 0xF0E9,\\n  \\\"nf-fa-wifi (F1EB)\\\": 0xF1EB,\\n  \\\"nf-fa-signal F1EB\\\": 0xF1EB,\\n  \\\"nf-oct-wifi F639\\\": 0xF639,\\n  \\\"nf-md-wifi-strength-1 ea90\\\": 0xEA90,\\n  \\\"nf-md-wifi-strength-2 ea91\\\": 0xEA91,\\n  \\\"nf-md-wifi-strength-3 ea92\\\": 0xEA92,\\n  \\\"nf-md-wifi-strength-4 ea93\\\": 0xEA93,\\n  \\\"nf-md-access-point-network-wireless ea7f\\\": 0xEA7F,\\n  \\\"nf-fa-ethernet f6ff\\\": 0xF6FF,\\n  \\\"nf-fa-plug f1e6\\\": 0xF1E6,\\n  \\\"nf-mdi-lan f0653?\\\": 0xF0653,\\n}\\nfor name, cp in tests.items():\\n    print(f\\\"  U+{cp:04X} {name:45s} -> {'YES' if cp in chars else 'no'}\\\")\\nEOF\"]" cwd=/home/solar http.span=734785 role=server
timestamp=2026-09-26T20:14:01.347Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\nimport struct\\np = \\\"/home/solar/.local/share/fonts/JetBrains-Mono-Nerd-Font-Complete.ttf\\\"\\nd = open(p,'rb').read()\\nnum = struct.unpack('>H', d[4:6])[0]\\ntabs = {}\\nfor i in range(num):\\n    off = 12 + i*16\\n    tag = d[off:off+4].decode('latin1')\\n    o, l = struct.unpack('>II', d[off+8:off+16])\\n    tabs[tag] = (o, l)\\n\\n# post table -> glyph names (format 2.0)\\npo, pl = tabs['post']\\nver = struct.unpack('>I', d[po:po+4])[0]\\nnames = ['']\\nif ver == 0x20000:\\n    n = struct.unpack('>H', d[po+32:po+34])[0]\\n    idx = []\\n    for i in range(n):\\n        idx.append(struct.unpack('>H', d[po+34+i*2:po+36+i*2])[0])\\n    end_names = po+34+n*2\\n    L = struct.unpack('>H', d[end_names:end_names+2])[0]\\n    stringdata = d[end_names+2:end_names+2+L]\\n    def getname(i):\\n        if i < 258: return None\\n        j = i-258\\n        ln = stringdata[j]\\n        return stringdata[j+1:j+1+ln].decode('latin1', 'replace')\\n    for i in idx:\\n        nm = getname(i)\\n        names.append(nm if nm is not None else '')\\n\\n# cmap codepoint -> glyph id\\ndef read_cmap4(o,l):\\n    n = struct.unpack('>H', d[o+2:o+4])[0]\\n    best=None\\n    for i in range(n):\\n        r=o+4+i*8\\n        pid,eid,sub=struct.unpack('>HHI', d[r:r+8])\\n        fmt=struct.unpack('>H', d[o+sub:o+sub+2])[0]\\n        if fmt==4: best=o+sub\\n    chars={}\\n    if best is None: return chars\\n    segX2=struct.unpack('>H', d[best+6:best+8])[0]; seg=segX2//2\\n    endB=best+14; startB=endB+segX2+2; deltaB=startB+segX2; rangeB=deltaB+segX2\\n    for i in range(seg):\\n        end=struct.unpack('>H', d[endB+i*2:endB+i*2+2])[0]\\n        start=struct.unpack('>H', d[startB+i*2:startB+i*2+2])[0]\\n        delta=struct.unpack('>h', d[deltaB+i*2:deltaB+i*2+2])[0]\\n        ro=struct.unpack('>H', d[rangeB+i*2:rangeB+i*2+2])[0]\\n        if start==0xFFFF: continue\\n        for c in range(start, end+1):\\n            if ro==0: g=(c+delta)&0xFFFF\\n            else:\\n                gi=rangeB+i*2+ro+(c-start)*2\\n                g=struct.unpack('>H', d[gi:gi+2])[0]\\n                if g: g=(g+delta)&0xFFFF\\n            if g: chars[c]=g\\n    return chars\\ncmap = read_cmap4(*tabs['cmap'])\\n\\n# find all glyphs whose name mentions wifi or signal\\nhits = []\\nfor cp, gid in cmap.items():\\n    nm = names[gid] if gid < len(names) else ''\\n    ln = nm.lower()\\n    if ('wifi' in ln or 'signal' in ln or 'wireless' in ln) and ('strength' in ln or 'wifi' in ln or 'signal' in ln):\\n        hits.append((cp, nm))\\nhits.sort()\\nseen=set()\\nfor cp, nm in hits:\\n    if nm in seen: continue\\n    seen.add(nm)\\n    print(f\\\"U+{cp:04X}  {nm}\\\")\\nprint(\\\"total distinct:\\\", len(seen))\\nEOF\"]" cwd=/home/solar http.span=741223 role=server
timestamp=2026-09-26T20:14:05.603Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"python3 - <<'EOF'\\nimport struct\\np = \\\"/home/solar/.local/share/fonts/JetBrains-Mono-Nerd-Font-Complete.ttf\\\"\\nd = open(p,'rb').read()\\nnum = struct.unpack('>H', d[4:6])[0]\\ntabs = {}\\nfor i in range(num):\\n    off = 12 + i*16\\n    tag = d[off:off+4].decode('latin1')\\n    o, l = struct.unpack('>II', d[off+8:off+16])\\n    tabs[tag] = (o, l)\\npo, pl = tabs['post']\\nver = struct.unpack('>I', d[po:po+4])[0]\\nprint(\\\"post version: %08X  table len %d\\\" % (ver, pl))\\nnames = None\\nif ver == 0x20000:\\n    n = struct.unpack('>H', d[po+32:po+34])[0]\\n    idx = [struct.unpack('>H', d[po+34+i*2:po+36+i*2])[0] for i in range(n)]\\n    p_end = po + 34 + n*2\\n    L = struct.unpack('>H', d[p_end:p_end+2])[0]\\n    sd = d[p_end+2:p_end+2+L]\\n    def getname(i):\\n        if i < 258: return None\\n        j = i - 258\\n        if j >= len(sd): return ''\\n        ln = sd[j]\\n        return sd[j+1:j+1+ln].decode('latin1','replace')\\n    names = [(getname(i) or '') for i in idx]\\n    print(\\\"num custom names:\\\", n, \\\"max index:\\\", max(idx))\\nimport pickle\\npickle.dump({'names':names}, open('/tmp/nf_names.pkl','wb'))\\nprint(\\\"dumped\\\")\\nEOF\"]" cwd=/home/solar http.span=745479 role=server

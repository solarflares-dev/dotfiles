lse:\\n            gi=rangeB+i*2+ro+(c-start)*2\\n            g=struct.unpack('>H', d[gi:gi+2])[0]\\n            if g: g=(g+delta)&0xFFFF\\n        if g and g not in rev: rev[g]=c\\n\\nout=[]\\nfor nm, gid in name2idx.items():\\n    ln=nm.lower()\\n    if ln.startswith('nf-md-wifi') or ln.startswith('nf-md-signal') or 'wifi-strength' in ln or ln.startswith('nf-mdi-wifi') or ln.startswith('nf-mdi-signal') or ln.startswith('nf-mdi-access-point') or ln.startswith('nf-md-access-point') or ln.startswith('nf-mdi-lan') or ln.startswith('nf-md-lan'):\\n        if gid in rev:\\n            out.append((rev[gid], nm))\\nout.sort()\\nfor cp,nm in out:\\n    print(f\\\"U+{cp:04X}  {nm}\\\")\\nprint(\\\"count:\\\", len(out))\\nEOF\"]" cwd=/home/solar http.span=752561 role=server

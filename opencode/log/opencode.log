timestamp=2026-09-26T20:22:47.015Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"cd /tmp/wbtest\\nh() { # prints REAL bar height + whether clamped\\n  out=$(timeout 8 waybar -c \\\"$2\\\" -s \\\"$1\\\" -l trace 2>&1)\\n  bh=$(echo \\\"$out\\\" | grep -oE \\\"Bar configured \\\\(width: [0-9]+, height: [0-9]+\\\\)\\\" | grep -oE \\\"height: [0-9]+\\\" | grep -oE \\\"[0-9]+\\\")\\n  cl=$(echo \\\"$out\\\" | grep -c \\\"less than the minimum\\\")\\n  printf \\\"bar=%-4s clamped=%s\\\\n\\\" \\\"${bh:-NONE}\\\" \\\"$cl\\\"\\n}\\nIMG='\\\"image#arch\\\":{\\\"path\\\":\\\"~/.config/waybar/assets/arch.png\\\",\\\"size\\\":18}'\\nCLK='\\\"clock\\\":{\\\"format\\\":\\\"{:%H:%M}\\\"}'\\nmk() { cat > \\\"$1\\\" <<EOF\\n{ \\\"layer\\\":\\\"top\\\",\\\"position\\\":\\\"top\\\",\\\"height\\\":15,\\\"exclusive\\\":true, $2 }\\nEOF\\n}\\nmk c1.json \\\"\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK\\\"\\nmk c2.json \\\"\\\\\\\"modules-left\\\\\\\":[\\\\\\\"image#arch\\\\\\\"],$IMG\\\"\\nmk c3.json \\\"\\\\\\\"modules-right\\\\\\\":[\\\\\\\"network\\\\\\\"],\\\\\\\"network\\\\\\\":{\\\\\\\"format-ethernet\\\\\\\":\\\\\\\"{icon}  {ipaddr}\\\\\\\",\\\\\\\"format-icons\\\\\\\":[\\\\\\\"\\\\\\\\uf1eb\\\\\\\",\\\\\\\"\\\\\\\\uf1ec\\\\\\\",\\\\\\\"\\\\\\\\uf1ed\\\\\\\",\\\\\\\"\\\\\\\\uf1ee\\\\\\\"]}\\\"\\nmk c4.json \\\"\\\\\\\"modules-right\\\\\\\":[\\\\\\\"network\\\\\\\"],\\\\\\\"network\\\\\\\":{\\\\\\\"format-ethernet\\\\\\\":\\\\\\\"{ipaddr}\\\\\\\"}\\\"\\nmk c5.json \\\"\\\\\\\"modules-left\\\\\\\":[\\\\\\\"image#arch\\\\\\\"],$IMG,\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK,\\\\\\\"modules-right\\\\\\\":[\\\\\\\"network\\\\\\\"],$NET_full\\\"\\nNET_full='\\\"network\\\":{\\\"format-ethernet\\\":\\\"{icon}  {ipaddr}\\\",\\\"format-icons\\\":[\\\"\\\"]}'\\nmk c5.json \\\"\\\\\\\"modules-left\\\\\\\":[\\\\\\\"image#arch\\\\\\\"],$IMG,\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK,\\\\\\\"modules-right\\\\\\\":[\\\\\\\"network\\\\\\\"],$NET_full\\\"\\n\\necho \\\"clock only        : $(h ~/.config/waybar/style.css c1.json)\\\"\\necho \\\"image only        : $(h ~/.config/waybar/style.css c2.json)\\\"\\necho \\\"network+FA icons  : $(h ~/.config/waybar/style.css c3.json)\\\"\\necho \\\"network ipaddr    : $(h ~/.config/waybar/style.css c4.json)\\\"\\necho \\\"ALL THREE         : $(h ~/.config/waybar/style.css c5.json)\\\"\\necho \\\"REAL config       : $(h ~/.config/waybar/style.css ~/.config/waybar/config.jsonc)\\\"\"]" cwd=/home/solar http.span=1266891 role=server

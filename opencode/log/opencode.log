timestamp=2026-09-26T20:20:28.992Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"cd /tmp/wbtest\\nprobe() {\\n  cat > c.json <<'EOF'\\n{ \\\"layer\\\":\\\"top\\\",\\\"position\\\":\\\"top\\\",\\\"height\\\":15,\\\"exclusive\\\":true,\\n  \\\"modules-left\\\":[\\\"image#arch\\\"],\\n  \\\"image#arch\\\":{\\\"path\\\":\\\"~/.config/waybar/assets/arch.png\\\",\\\"size\\\":18},\\n  \\\"modules-center\\\":[\\\"clock\\\"],\\n  \\\"clock\\\":{\\\"format\\\":\\\"{:%H:%M}\\\"},\\n  \\\"modules-right\\\":[\\\"network\\\"],\\n  \\\"network\\\":{\\\"format-icons\\\":[\\\"\\\"]} }\\nEOF\\n  printf '%s' \\\"$1\\\" > s3.css\\n  out=$(timeout 3 waybar -c c.json -s s3.css -l trace 2>&1)\\n  h=$(echo \\\"$out\\\" | grep -oE \\\"width: [0-9]+, height: [0-9]+\\\" | head -1)\\n  w=$(echo \\\"$out\\\" | grep -c \\\"less than the minimum\\\")\\n  echo \\\"  $2  =>  ${h:-<no bar>}   (clamped=$w)\\\"\\n}\\nBASE='* { font-family:\\\"JetBrainsMono Nerd Font\\\",monospace; border:none; border-radius:0; }\\n#clock { font-size:15px; }\\n#network { font-size:13px; }'\\nprobe \\\"$BASE\\\" \\\"baseline, nothing forced\\\"\\nprobe \\\"$BASE\\n#clock,#network,#arch { min-height:0; }\\\" \\\"+ min-height:0 only\\\"\\nprobe \\\"$BASE\\n#clock,#network,#arch { min-height:0; padding:0 7px; }\\\" \\\"+ min-height:0, no vpad\\\"\\nprobe \\\"$BASE\\n#clock,#network,#arch { min-height:0; height:15px; padding:0 7px; }\\\" \\\"+ forced height:15px\\\"\\nprobe \\\"$BASE\\n#clock,#network,#arch { min-height:0; max-height:15px; height:15px; padding:0 7px; }\\\" \\\"+ min/max/height 15px\\\"\"]" cwd=/home/solar http.span=1128868 role=server
timestamp=2026-09-26T20:20:49.333Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"cd /tmp/wbtest\\ncat > c.json <<'EOF'\\n{ \\\"layer\\\":\\\"top\\\",\\\"position\\\":\\\"top\\\",\\\"height\\\":15,\\\"exclusive\\\":true,\\n  \\\"modules-left\\\":[\\\"image#arch\\\"],\\n  \\\"image#arch\\\":{\\\"path\\\":\\\"~/.config/waybar/assets/arch.png\\\",\\\"size\\\":18},\\n  \\\"modules-center\\\":[\\\"clock\\\"],\\n  \\\"clock\\\":{\\\"format\\\":\\\"{:%H:%M}\\\"},\\n  \\\"modules-right\\\":[\\\"network\\\"],\\n  \\\"network\\\":{\\\"format-icons\\\":[\\\"\\\"]} }\\nEOF\\ncat > s3.css <<'EOF'\\n* { font-family:\\\"JetBrainsMono Nerd Font\\\",monospace; border:none; border-radius:0; }\\n#clock { font-size:15px; }\\n#network { font-size:13px; }\\n#clock,#network,#arch { min-height:0; height:15px; padding:0 7px; }\\nEOF\\ntimeout 3 waybar -c c.json -s s3.css -l trace 2>&1 | tail -25\"]" cwd=/home/solar http.span=1149209 role=server
timestamp=2026-09-26T20:20:58.814Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"cd /tmp/wbtest\\nCSS_HEAD='* { font-family:\\\"JetBrainsMono Nerd Font\\\",monospace; border:none; border-radius:0; }'\\nrun() { # $1=label  $2=extra css  $3=modules json\\n  cat > c.json <<EOF\\n{ \\\"layer\\\":\\\"top\\\",\\\"position\\\":\\\"top\\\",\\\"height\\\":15,\\\"exclusive\\\":true, $3 }\\nEOF\\n  printf '%s\\\\n%s\\\\n' \\\"$CSS_HEAD\\\" \\\"$2\\\" > s4.css\\n  out=$(timeout 3 waybar -c c.json -s s4.css -l trace 2>&1)\\n  h=$(echo \\\"$out\\\" | grep -oE \\\"height: [0-9]+\\\" | head -1)\\n  bad=$(echo \\\"$out\\\" | grep -oE \\\"'[a-z-]+' is not a valid\\\" | head -1)\\n  echo \\\"  $1 => ${h:-FAILED} ${bad}\\\"\\n}\\nIMG='\\\"image#arch\\\":{\\\"path\\\":\\\"~/.config/waybar/assets/arch.png\\\",\\\"size\\\":18}'\\nCLK='\\\"clock\\\":{\\\"format\\\":\\\"{:%H:%M}\\\"}'\\nNET='\\\"network\\\":{\\\"format-icons\\\":[\\\"x\\\"]}'\\n\\necho \\\"--- isolate: which module forces 21px? (height:15 requested) ---\\\"\\nrun \\\"clock only\\\"      ''      \\\"\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK\\\"\\nrun \\\"image only\\\"      ''      \\\"\\\\\\\"modules-left\\\\\\\":[\\\\\\\"image#arch\\\\\\\"],$IMG\\\"\\nrun \\\"network only\\\"    ''      \\\"\\\\\\\"modules-right\\\\\\\":[\\\\\\\"network\\\\\\\"],$NET\\\"\\n\\necho \\\"--- valid GTK props to force it down ---\\\"\\nrun \\\"all + max-height:15\\\"  '#clock,#network,#arch{max-height:15px;}' \\\"\\\\\\\"modules-left\\\\\\\":[\\\\\\\"image#arch\\\\\\\"],$IMG,\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK,\\\\\\\"modules-right\\\\\\\":[\\\\\\\"network\\\\\\\"],$NET\\\"\\nrun \\\"all + min:0 max:15\\\"   '#clock,#network,#arch{min-height:0;max-height:15px;}' \\\"\\\\\\\"modules-left\\\\\\\":[\\\\\\\"image#arch\\\\\\\"],$IMG,\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK,\\\\\\\"modules-right\\\\\\\":[\\\\\\\"network\\\\\\\"],$NET\\\"\"]" cwd=/home/solar http.span=1158690 role=server
timestamp=2026-09-26T20:21:19.951Z level=INFO run=bc2d237c message="spawning process" command=/usr/bin/bash args="[\"-c\",\"cd /tmp/wbtest\\nCSS_HEAD='* { font-family:\\\"JetBrainsMono Nerd Font\\\",monospace; border:none; border-radius:0; }'\\nrun() {\\n  cat > c.json <<EOF\\n{ \\\"layer\\\":\\\"top\\\",\\\"position\\\":\\\"top\\\",\\\"height\\\":15,\\\"exclusive\\\":true, $3 }\\nEOF\\n  printf '%s\\\\n%s\\\\n' \\\"$CSS_HEAD\\\" \\\"$2\\\" > s5.css\\n  out=$(timeout 3 waybar -c c.json -s s5.css -l trace 2>&1)\\n  h=$(echo \\\"$out\\\" | grep -oE \\\"height: [0-9]+\\\" | head -1)\\n  bad=$(echo \\\"$out\\\" | grep -oE \\\"'[a-z-]+' is not a valid\\\" | head -1)\\n  echo \\\"  $1 => ${h:-FAILED} $bad\\\"\\n}\\nIMG='\\\"image#arch\\\":{\\\"path\\\":\\\"~/.config/waybar/assets/arch.png\\\",\\\"size\\\":18}'\\nCLK='\\\"clock\\\":{\\\"format\\\":\\\"{:%H:%M}\\\"}'\\nNET='\\\"network\\\":{\\\"format-icons\\\":[\\\"x\\\"]}'\\nALL=\\\"\\\\\\\"modules-left\\\\\\\":[\\\\\\\"image#arch\\\\\\\"],$IMG,\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK,\\\\\\\"modules-right\\\\\\\":[\\\\\\\"network\\\\\\\"],$NET\\\"\\n\\nrun \\\"A: all 3, default font sizes\\\"        ''                              \\\"$ALL\\\"\\nrun \\\"B: all 3, clock=15px (current real)\\\" '#clock{font-size:15px;}'         \\\"$ALL\\\"\\nrun \\\"C: clock ONLY, font=15px\\\"            '#clock{font-size:15px;}'         \\\"\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK\\\"\\nrun \\\"D: clock ONLY 15px + min-height:0\\\"   '#clock{font-size:15px;min-height:0;}' \\\"\\\\\\\"modules-center\\\\\\\":[\\\\\\\"clock\\\\\\\"],$CLK\\\"\\nrun \\\"E: all 3, clock15 + min-height:0\\\"    '#clock{font-size:15px;} #clock,#network,#arch{min-height:0;}' \\\"$ALL\\\"\\nrun \\\"F: all 3, clock15 + padding 0\\\"       '#clock{font-size:15px;} #clock,#network,#arch{padding:0;}'     \\\"$ALL\\\"\"]" cwd=/home/solar http.span=1179827 role=server

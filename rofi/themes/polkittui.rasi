/* Import your existing config to keep your colors and fonts */
@import "config.rasi"

window {
    location:           center;
    anchor:             center;     /* Explicitly grounds the calculation at the center */
    y-offset:           -80px;
    width:              340px;  
    height:             74px;   /* Exact height for a sleek single line row */
    
    background-color:   @bg0;
    border:             2px;    /* 0px so Hyprland handles window frames exclusively */
    border-radius:      0px;
    padding:            12px;
}

/* DO NOT USE ENABLED: FALSE. We squash it down visually instead */
message {
    padding:            0px;
    margin:             0px;
    border:             0px;
}

textbox {
    padding:            0px;
    margin:             0px;
    border:             0px;
    text-color:         transparent; /* Hides the prompt text from printing */
    font:               "Arial 1";   /* Shrinks container allocation scale */
}

mainbox {
    children:           [ message, inputbar ];
    spacing:            0px;
}

inputbar {
    children:           [ entry ]; 
    padding:            0px;
    background-color:   transparent;
}

entry {
    background-color:   #000000; 
    padding:            10px;
    text-color:         @fg0;
    placeholder:        "Password...";
    placeholder-color:  #555555; 
}

listview {
    enabled:            false;
}

